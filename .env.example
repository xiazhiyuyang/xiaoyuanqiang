# 校园墙生产环境配置示例
DEBUG=False
SECRET_KEY=please-change-to-a-random-secret-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-admin-password

# MySQL（推荐生产使用）
# 注意密码中的 @ : / # 等特殊字符需要 URL encode
DATABASE_URL=mysql+aiomysql://campus_wall:your_password@127.0.0.1:3306/campus_wall?charset=utf8mb4

# SQLite（本地开发/轻量部署可切换回）
# DATABASE_URL=sqlite+aiosqlite:////www/wwwroot/campus-wall/data/campus_wall.db

CORS_ORIGINS=
